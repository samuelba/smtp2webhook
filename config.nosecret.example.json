{
  "_comment": "Example: Webhooks Without Secrets (Unsigned)",
  "_comment_description": "Demonstrates webhook configuration without HMAC signatures. Use when webhook receiver doesn't support signature verification",
  
  "server": {
    "port": 2525,
    "hostname": "smtp.example.com",
    "security_mode": "starttls",
    "tls_cert_path": "/etc/smtp-forwarder/certs/server.crt",
    "tls_key_path": "/etc/smtp-forwarder/certs/server.key",
    "max_email_size": 10485760,
    "max_concurrent_connections": 50,
    "read_timeout": 60,
    "write_timeout": 60
  },
  
  "auth": {
    "enabled": true,
    "credentials": [
      {
        "username": "testuser",
        "password": "testpass123"
      }
    ]
  },
  
  "routes": [
    {
      "pattern": "notifications@example.com",
      "webhook": {
        "url": "https://api.example.com/webhooks/notifications",
        "timeout": 30,
        "_comment": "No 'secret' field - webhook will be sent without webhook-signature header"
      }
    },
    {
      "pattern": "*@example.com",
      "webhook": {
        "url": "https://api.example.com/webhooks/catchall",
        "timeout": 30,
        "_comment": "Also unsigned - Standard Webhooks headers (id, timestamp) still included"
      }
    }
  ],
  
  "defaults": {}
}
