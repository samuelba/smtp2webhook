{
  "server": {
    "port": 2525,
    "hostname": "localhost",
    "security_mode": "none",
    "max_email_size": 10485760,
    "max_concurrent_connections": 50,
    "read_timeout": 60,
    "write_timeout": 60
  },
  "auth": {
    "enabled": false,
    "credentials": []
  },
  "routes": [
    {
      "pattern": "*@example.com",
      "webhook": {
        "url": "http://localhost:8080/webhook",
        "timeout": 30
      }
    }
  ],
  "defaults": {}
}
